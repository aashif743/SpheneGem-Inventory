Options -MultiViews
RewriteEngine On

# Asset files under /static are hashed. If one is missing, return a real 404
# instead of index.html (serving HTML as JS gives a blank white screen).
RewriteRule ^static/ - [L]

# Everything else that is not a real file is a React route -> index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.html [QSA,L]

# index.html must always be re-checked so browsers pick up new deploys.
# Hashed assets can be cached for a long time.
<IfModule mod_headers.c>
  <FilesMatch "^(index\.html)?$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
